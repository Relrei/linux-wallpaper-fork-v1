+static unsigned int gl_filter(spine::TextureFilter filter, bool isMinFilter) {
+	switch (filter) {
+		case spine::TextureFilter_Nearest: return GL_NEAREST;
+		case spine::TextureFilter_Linear: return GL_LINEAR;
+		case spine::TextureFilter_MipMap:
+		case spine::TextureFilter_MipMapLinearLinear: return isMinFilter ? GL_LINEAR_MIPMAP_LINEAR : GL_LINEAR;
+		case spine::TextureFilter_MipMapNearestNearest: return isMinFilter ? GL_NEAREST_MIPMAP_NEAREST : GL_NEAREST;
+		case spine::TextureFilter_MipMapLinearNearest: return isMinFilter ? GL_LINEAR_MIPMAP_NEAREST : GL_LINEAR;
+		case spine::TextureFilter_MipMapNearestLinear: return isMinFilter ? GL_NEAREST_MIPMAP_LINEAR : GL_NEAREST;
+		default: return GL_LINEAR;
+	}
+}
